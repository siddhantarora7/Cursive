# ===== Cursive AI proxy (Vercel env vars — never committed) =====

# Free-tier provider chain, tried in order. Format: provider:model[,provider:model]
# Supported providers: groq, gemini. Swapping models/providers is config, not code.
PROVIDER_CHAIN=groq:llama-3.1-8b-instant,gemini:gemini-2.5-flash-lite

GROQ_API_KEY=
GEMINI_API_KEY=

# Upstash Redis (free tier) for caps + rate limits. Unset → limits are skipped (dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Caps
DAILY_CAP=150            # per anonymous client id, per UTC day
IP_DAILY_CAP=400         # per IP per day (cost backstop; client ids are resettable)
RATE_LIMIT_PER_MIN=20    # per IP burst limit

# Kill switch: set to 1 to disable all free-tier AI instantly
AI_DISABLED=0
